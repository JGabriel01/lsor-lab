#!/bin/bash
set -e

# Configura IP na LAN e rota padrao pelo roteador gw
ip addr add 10.10.2.10/24 dev eth0
ip link set eth0 up
ip route add default via 10.10.2.1

# Gera par de chaves SSH no boot e publica a chave publica em /shared/keys
mkdir -p /root/.ssh /shared/keys
chmod 700 /root/.ssh
rm -f /root/.ssh/id_ed25519 /root/.ssh/id_ed25519.pub
ssh-keygen -t ed25519 -N "" -f /root/.ssh/id_ed25519 -C "admin@lan" >/dev/null
cp /root/.ssh/id_ed25519.pub /shared/keys/admin.pub

cat <<'EOF' > /root/.ssh/config
Host *
    StrictHostKeyChecking accept-new
EOF
chmod 600 /root/.ssh/config
