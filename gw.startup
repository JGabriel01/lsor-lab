#!/bin/bash
set -e

# Configura as tres interfaces do roteador
ip addr add 203.0.113.1/24 dev eth0
ip link set eth0 up

ip addr add 10.10.1.1/24 dev eth1
ip link set eth1 up

ip addr add 10.10.2.1/24 dev eth2
ip link set eth2 up

# Aplica as regras de NAT e Firewall
chmod +x /etc/firewall.sh
/etc/firewall.sh
